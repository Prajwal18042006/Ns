#include<iostream>
using namespace std;

// encryption
string encryption(string text,int key){

    string ans="";

    for(int i=0;i<key;i++){

        for(int j=i;j<text.size();j+=key){
            ans += text[j];
        }
    }
    return ans;
}

// decryption
string decryption(string cipher,int key){

    string ans(cipher.size(),' ');
    int index = 0;

    for(int i=0;i<key;i++){

        for(int j=i;j<cipher.size();j+=key){
            ans[j] = cipher[index++];
        }
    }

    return ans;
}

int main(){

    string text;
    int key;

    cout<<"Enter your string here:"<<endl;
    cin>>text;

    cout<<"Enter your key here:"<<endl;
    cin>>key;

    string enc = encryption(text,key);
    string dec = decryption(enc,key);

    cout<<"Encrypted text: "<<enc<<endl;
    cout<<"Decrypted text: "<<dec<<endl;

    return 0;
}
