#include<iostream>
using namespace std;

string encryption(string text ,int key){
    string ans="";
    
    for(int i=0;i<text.size();i++){
        if(isupper(text[i])){
            ans+=char((text[i]-'A'+key)%26+'A');
        }
        else if(islower(text[i])){
            ans+=char((text[i]-'a'+key)%26+'a');
            
        }
        else{
            ans+=text[i];
            
        }
    }
    return ans;
    
}

string decryption(string text,int key){
    string ans="";
    
    for(int i=0;i<text.size();i++){
        if(isupper(text[i])){
            ans+=char((text[i]-'A'-key+26)%26+'A');
            
        }
        else if(islower(text[i])){
            ans+=char((text[i]-'a'-key+26)%26+'a');
            
        }
        else{
            ans+=text[i];
            
        }
    }
    return ans;
    
}


int main(){
    string text;
    int key;
    cout<<"Enter your string here:"<<endl;
    cin>>text;
    cout<<"Enter your key here :"<<endl;
    cin>>key;
    
    string enc=encryption(text,key);
    string dec=decryption(enc,key);
    
    cout<<"enc:"<<enc<<endl;
    cout<<"dec:"<<dec<<endl;
    return 0;
    
    
    
}
